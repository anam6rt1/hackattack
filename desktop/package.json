{
  "name": "telebac-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "TeleBac pentru Windows și Linux: aceeași platformă, cu lecțiile descărcate disponibile și fără internet.",
  "main": "main.js",
  "author": "TeleBac",
  "scripts": {
    "site": "npm --prefix ../frontend run build:aplicatii",
    "start": "electron .",
    "dist:win": "npm run site && electron-builder --win",
    "dist:linux": "npm run site && electron-builder --linux AppImage",
    "test": "node test-aplicatie.mjs",
    "dist:win:linux": "npm run site && electron-builder --win -c.win.signAndEditExecutable=false"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "ro.telebac.desktop",
    "productName": "TeleBac",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/out",
        "to": "site"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../frontend/public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "TeleBac-${version}-portabil.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "../frontend/public/icon-512.png"
    }
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
