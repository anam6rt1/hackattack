# Model pentru ~/.config/markai/markai.env — singurul loc cu secrete și setări locale.
# Copiază-l acolo (chmod 600) și completează valorile; fișierul real nu se pune niciodată în Git.
# Îl încarcă porneste-public.sh / porneste-local.sh (prin incarca-setari.sh). Cheile cu `__` suprascriu appsettings.json
# (de ex. Twilio__Numar = Twilio:Numar). Cheile comentate sunt opționale.

# --- Bază de date (obligatoriu) ---
MARKAI_CONNECTION_STRING='Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=SCHIMBA-MA'

# --- Sesiuni (obligatoriu în Production; minim 32 de caractere aleatorii, de ex. `openssl rand -base64 48`) ---
MARKAI_JWT_KEY=SCHIMBA-MA-cu-cel-putin-32-de-caractere-aleatorii

# --- AI (cel puțin una; Claude are prioritate dacă sunt amândouă) ---
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Gemini__Model=gemini-3.5-flash-lite
# Gemini__ModelTelefon=

# --- Twilio, Linia AI la telefon (opțional; fără ele apelurile sunt oprite) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Twilio__Numar=+40...
# Twilio__Trial=true
# Twilio__UrlPublic se setează automat de porneste-public.sh (adresa tunelului).

# --- Email SMTP (opțional acum; necesar pentru confirmarea contului din faza 2) ---
# SetariEmail__Host=smtp-relay.brevo.com
# SetariEmail__Port=587
# SetariEmail__Tls=true
# SetariEmail__Utilizator=
# SetariEmail__Parola=
# SetariEmail__Expeditor=TeleBac <no-reply@exemplu.ro>

# --- Sesiuni / cookie ---
# Autentificare__DurataZile=14
# Autentificare__CookieSecure=false

# --- Contul de administrator creat de `MarkAi.Database seed` (doar la prima configurare) ---
# MARKAI_ADMIN_EMAIL=
# MARKAI_ADMIN_PAROLA=

# --- Verificări de integrare (database/tests): server PostgreSQL de test cu drept CREATEDB, NU baza reală ---
# MARKAI_TEST_CONNECTION='Host=localhost;Port=55432;Username=postgres;Password=test'
